DATABASE_URL=postgres://postgres:postgres@localhost:5432/easy_vibe_coding
PORT=3000
# JWT signing secret (HS256) — must be at least 32 chars. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# AES-256-GCM key for encrypted secrets (libs/crypto) — 64 hex chars. Generate:
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-64-hex-chars-from-openssl-rand-hex-32
